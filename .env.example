# Northstar Dispo — copy to `.env` and fill secrets.
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app boots with mail left blank. Never commit `.env`.

# --- runtime ---
ENVIRONMENT=local
APP_VERSION=dev
APP_COMMIT=unknown
LOG_LEVEL=info
SENTRY_DSN=

# --- brand (public, safe to expose via /api/v1/public/config) ---
PUBLIC_BRAND_NAME=Northstar Dispo
PUBLIC_BRAND_TAGLINE=
PUBLIC_DOMAIN=localhost
PUBLIC_SUPPORT_PHONE=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_LOGO_URL=
PUBLIC_FOOTER_LEGAL_NAME=
PUBLIC_PRIMARY_STATE=TX
PUBLIC_MAILING_ADDRESS=

# --- auth / product policy ---
REQUIRE_ADMIN_APPROVAL=true
REQUIRE_EMAIL_VERIFICATION=auto
ADMIN_REQUIRE_2FA=false
SECRET_KEY=
SECRET_KEY_PREVIOUS=
JWT_ISSUER=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_NAME_PREFIX=
TERMS_VERSION=2026-08-22
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- database / redis / s3 ---
# Local-first (no Docker): SQLite + empty Redis + filesystem media.
# When Compose is up, switch to the postgresql / redis / minio URLs below.
DATABASE_URL=sqlite+aiosqlite:///./data/northstar.db
REDIS_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PHOTOS=photos
S3_BUCKET_DOCS=docs
LOCAL_MEDIA_DIR=./data/media

# Compose (later):
# DATABASE_URL=postgresql+psycopg://northstar:northstar@postgres:5432/northstar
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# --- mailbox (Gmail app password — 16 chars, spaces optional) ---
# Leave blank to run sandbox mail (writes .eml to storage, no network).
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_POLL_SECONDS=60
MAIL_DAILY_LIMIT=450
MAIL_RATE_PER_MINUTE=20

# --- maps (no keys required for OSM + Esri imagery) ---
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_SAT_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=NorthstarDispo/1.0 (contact: support@localhost)

# --- uploads / deal features ---
PHOTO_MAX_MB=15
DOC_MAX_MB=25
WATERMARK_DOWNLOADS=false
EARLY_ACCESS_DEFAULT_HOURS=0
VIDEO_EMBED_HOSTS=youtube.com,youtube-nocookie.com,vimeo.com,matterport.com

# --- hosting ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
COOKIE_SECURE=false
IMAGE_TAG=latest
